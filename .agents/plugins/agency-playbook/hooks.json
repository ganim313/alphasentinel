{
  "agency-lifecycle-guard": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python .agency/scripts/agency_hooks.py --event PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python .agency/scripts/agency_hooks.py --event PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python .agency/scripts/agency_hooks.py --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python .agency/scripts/agency_hooks.py --event Stop",
        "timeout": 5
      }
    ]
  },
  "hooks": {
    "enabled": false,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python .agency/scripts/agency_hooks.py --event PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python .agency/scripts/agency_hooks.py --event PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python .agency/scripts/agency_hooks.py --event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python .agency/scripts/agency_hooks.py --event Stop",
        "timeout": 5
      }
    ]
  }
}
