# =============================================================================
# AlphaSentinel Environment Variables Template ($0 Free-Tier Stack)
# =============================================================================

# System Configuration
APP_ENV=development # development | staging | production
LOG_LEVEL=INFO
DUCKDB_PATH=alphasentinel.duckdb
PAPER_TRADING_MODE=true # Mandatory 1-month paper trading gate

# LLM API Keys (Waterfall Priority: Gemini -> OpenRouter -> Groq)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Telegram Notifications & Control
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ADMIN_USER_ID=your_telegram_user_id_here

# Broker API (Paper Trading by default; optional for live execution after validation)
BROKER_NAME=FYERS # FYERS | DHAN | PAPER
BROKER_APP_ID=
BROKER_SECRET_KEY=
BROKER_ACCESS_TOKEN=

# Scraping & Ingestion
SCREENER_USERNAME=
SCREENER_PASSWORD=
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"

# Tailscale & Server Security
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
