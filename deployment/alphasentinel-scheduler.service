[Unit]
Description=AlphaSentinel Master Scheduler Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/alphasentinel
Environment="TZ=Asia/Kolkata"
ExecStart=/home/ubuntu/alphasentinel/venv/bin/python scripts/run_scheduler.py
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/alphasentinel/logs/scheduler.log
StandardError=append:/home/ubuntu/alphasentinel/logs/scheduler.log

[Install]
WantedBy=multi-user.target
