[Unit]
Description=AlphaSentinel Master Scheduler Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/trading-agents
ExecStart=/home/ubuntu/trading-agents/venv/bin/python scripts/run_scheduler.py
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/trading-agents/logs/scheduler.log
StandardError=append:/home/ubuntu/trading-agents/logs/scheduler.log

[Install]
WantedBy=multi-user.target
