[Unit]
Description=AlphaSentinel Streamlit Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/alphasentinel
Environment="TZ=Asia/Kolkata"
ExecStart=/home/ubuntu/alphasentinel/venv/bin/streamlit run dashboard/app.py --server.port 8501 --server.address 0.0.0.0
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/alphasentinel/logs/dashboard.log
StandardError=append:/home/ubuntu/alphasentinel/logs/dashboard.log

[Install]
WantedBy=multi-user.target
